<resources>
    <style name="Theme.HomeStream" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080808</item>
        <item name="android:navigationBarColor">#080808</item>
        <item name="android:windowBackground">#080808</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="colorAccent">#E50914</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.HomeStream.PlayerPanel" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="colorAccent">#E50914</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="buttonBarButtonStyle">@style/Widget.HomeStream.PlayerPanelButton</item>
    </style>
    <style name="Widget.HomeStream.PlayerPanelButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <string name="app_name">HomeStream</string>
</resources>
